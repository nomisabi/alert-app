{
  "name": "alert-app",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/shared",
    "alert-app-frontend",
    "alert-app-backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w alert-app-frontend",
    "dev:backend": "npm run start:dev -w alert-app-backend",
    "dev:shared": "npm run dev -w @alert-app/shared",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "postinstall": "npm run build -w @alert-app/shared"
  },
  "engines": {
    "node": ">=24.15"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
