# Copy this file to .env and adjust the values. Never commit .env.

# HTTP server
PORT=3000
# Frontend URL allowed to call the API (CORS)
CORS_ORIGIN=http://localhost:5174

# PostgreSQL from docker-compose.yml (see the root .env for user/password/port)
DATABASE_URL=postgresql://alert:alert@localhost:5433/alert_app?schema=public

# Better Auth: signs session cookies. Generate a new one per environment, at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# The backend's own URL
BETTER_AUTH_URL=http://localhost:3000

# First admin, created by: npm run db:seed (only used by the seed script)
ADMIN_NAME=Admin
ADMIN_USERNAME=admin.user
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-1
