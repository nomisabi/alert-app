# Copy this file to .env and adjust the values. Never commit .env.

# HTTP server
PORT=3000
# Frontend URL allowed to call the API (CORS)
CORS_ORIGIN=http://localhost:5174

# PostgreSQL from docker-compose.yml (see the root .env for user/password/port)
DATABASE_URL=postgresql://alert:alert@localhost:5433/alert_app?schema=public

# Better Auth: signs session cookies. Generate a new one per environment, at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# The backend's own URL
BETTER_AUTH_URL=http://localhost:3000

# First admin, created by: npm run db:seed (only used by the seed script)
ADMIN_NAME=Admin
ADMIN_USERNAME=admin.user
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-1

# Email (Resend, https://resend.com → API Keys). Leave empty to only write emails to the log.
# Without a verified domain, Resend only delivers to the email address of the Resend account.
RESEND_API_KEY=
# Sender. onboarding@resend.dev is Resend's test sender (no domain needed).
EMAIL_FROM=Alert App <onboarding@resend.dev>

# Slack: users paste their own webhook URLs, so there is no key. false = Slack messages are only
# written to the log (the e2e tests set this, see test/setup-e2e.ts).
SLACK_ENABLED=true

# Background jobs: Redis from docker-compose.yml (npm run db:up)
REDIS_URL=redis://localhost:6379

# News (NewsData.io, https://newsdata.io → API Key). Leave empty to fetch no news.
NEWSDATA_API_KEY=
# How often news is fetched, in minutes (min 15). Each fetch uses 10 of the ~200 free requests/day.
NEWS_POLL_INTERVAL_MINUTES=120
