// Database schema.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (milestone 1)
// The User, Session, Account and Verification models are the tables Better Auth
// needs (https://better-auth.com/docs/concepts/database). Field names must match
// what Better Auth expects. Extra fields come from Better Auth's plugins: username/
// displayUsername (username plugin), role/banned/banReason/banExpires/impersonatedBy (admin plugin).
// ---------------------------------------------------------------------------

enum Role {
  user
  admin
}

model User {
  id              String      @id
  // Display name (free text, not unique). Better Auth calls it "name".
  name            String
  email           String      @unique
  emailVerified   Boolean     @default(false)
  image           String?
  // Lowercased by the username plugin, so uniqueness is case-insensitive.
  username        String      @unique
  // The username as the user typed it (set automatically by the plugin).
  displayUsername String
  role            Role        @default(user)
  // Admin plugin (milestone 2): "banned" = disabled by an admin. Sessions are deleted and
  // login is blocked. banReason/banExpires are required by the plugin but not used yet.
  banned          Boolean     @default(false)
  banReason       String?
  banExpires      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  sessions        Session[]
  accounts        Account[]
  alertRules      AlertRule[]
  channels        Channel[]

  @@map("user")
}

// One row per logged-in browser. The browser's cookie holds the token.
model Session {
  id             String   @id
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  // Admin plugin: set when an admin logs in as another user. Required by the plugin, not used.
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

// How a user logs in. For email + password: providerId = "credential" and the
// password hash is stored here. Social logins (later) add more rows per user.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  password              String?
  // Only used by social logins (OAuth).
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

// Short-lived tokens, e.g. for email verification and password reset (milestone 9).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Alert rules (milestone 3)
// ---------------------------------------------------------------------------

// How a rule finds articles. Only the matching field is filled:
// keywords → keywords is filled, category is null
// category → category is filled, keywords is []
enum AlertRuleType {
  keywords
  category
}

model AlertRule {
  id            String             @id @default(uuid(7))
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  type          AlertRuleType
  // 1–10 keywords as the user typed them (trimmed). ALL of them must appear in the article
  // (AND). Matching ignores case, so no lowercase copy is stored.
  keywords      String[]           @default([])
  // One of APP_CATEGORIES (packages/shared). Plain text, checked by the shared Zod schema,
  // so changing the category list needs no migration.
  category      String?
  // Switched-off rules are kept but never matched.
  enabled       Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  // Where matches are sent. At least one (checked by the shared Zod schema and the service).
  channels      AlertRuleChannel[]
  notifications Notification[]

  @@index([userId])
  @@map("alert_rule")
}

// ---------------------------------------------------------------------------
// Channels (milestone 4)
// ---------------------------------------------------------------------------

// Adding a type is a one-line migration (ALTER TYPE ... ADD VALUE).
enum ChannelType {
  email
  slack
}

// Where a user's alerts are sent. Every user has exactly one email channel (their account
// email), created after sign-up, and at most one Slack channel (milestone 7). "One email channel"
// and "one Slack channel" are checked in the service.
model Channel {
  id             String             @id @default(uuid(7))
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           ChannelType
  // Settings that depend on the type, checked by the type's Zod schema. Email: {} (the address
  // is read from user.email when sending, so it is never out of date). Slack: { name, webhookUrl }
  // (the URL is a secret: never returned by the API or logged).
  config         Json               @default("{}")
  // For the "1 test message per minute" limit. Stored here, so it survives a restart.
  lastTestSentAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  alertRules     AlertRuleChannel[]
  notifications  Notification[]

  @@index([userId])
  @@map("channel")
}

// Join table: which rule sends to which channel (many-to-many). One row per pair, so the same
// pair can't be saved twice. Deleting a rule, a channel or a user removes its rows.
model AlertRuleChannel {
  alertRuleId String
  alertRule   AlertRule @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  channelId   String
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  // The primary key starts with alertRuleId, so it also serves "channels of a rule".
  // The extra index serves "rules of a channel".
  @@id([alertRuleId, channelId])
  @@index([channelId])
  @@map("alert_rule_channel")
}

// ---------------------------------------------------------------------------
// Alerts (milestone 5)
// ---------------------------------------------------------------------------

// One news article from a source, saved once. Sources overlap, so the URL is unique: the same
// story from a second source (or a second fetch) is skipped and never matched twice.
model Article {
  id            String                @id @default(uuid(7))
  // Which NewsSourceAdapter fetched it, e.g. "newsdata". Plain text: no Source table yet (milestone 8).
  sourceId      String
  // The provider's own id (NewsData.io: article_id)
  externalId    String
  url           String                @unique
  title         String
  description   String?
  imageUrl      String?
  // The publisher, e.g. "Ciodive" (shown in the alert email)
  sourceName    String?
  publishedAt   DateTime
  // Our APP_CATEGORIES, already mapped from the provider's (at least one, "other" if unknown)
  categories    String[]
  // e.g. "en". Only English is fetched for now.
  language      String?
  // When WE saved it (the provider's publishedAt can be hours older). A rule only matches
  // articles created after the rule itself, so a new rule doesn't send old news.
  createdAt     DateTime              @default(now())
  notifications NotificationArticle[]

  @@unique([sourceId, externalId])
  @@map("article")
}

enum NotificationStatus {
  pending
  sent
  failed
}

// One message to one channel: all new matches of a rule from one fetch together (so a busy
// category rule sends one email per fetch, not one per article).
model Notification {
  id          String                @id @default(uuid(7))
  alertRuleId String
  alertRule   AlertRule             @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  channelId   String
  channel     Channel               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  // The fetch (ingest job) that found the articles. With the unique key below, a match job that
  // runs twice (a retry after a crash) can't create the same message twice.
  batchId     String
  status      NotificationStatus    @default(pending)
  // Send attempts so far (the notify job tries 3 times, waiting longer each time)
  attempts    Int                   @default(0)
  // The last error, for the backend log and the admin notification log (milestone 8)
  error       String?
  sentAt      DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  articles    NotificationArticle[]

  @@unique([batchId, alertRuleId, channelId])
  // "When did this rule last send?" (the alerts list) reads the newest sentAt per rule
  @@index([alertRuleId, sentAt])
  @@index([channelId])
  @@map("notification")
}

// Join table: which articles are in a message (many-to-many, like AlertRuleChannel)
model NotificationArticle {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  articleId      String
  article        Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([notificationId, articleId])
  @@index([articleId])
  @@map("notification_article")
}
