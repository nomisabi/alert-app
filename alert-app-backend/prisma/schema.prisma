// Database schema.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (milestone 1)
// The User, Session, Account and Verification models are the tables Better Auth
// needs (https://better-auth.com/docs/concepts/database). Field names must match
// what Better Auth expects. Extra fields come from Better Auth's plugins: username/
// displayUsername (username plugin), role/banned/banReason/banExpires/impersonatedBy (admin plugin).
// ---------------------------------------------------------------------------

enum Role {
  user
  admin
}

model User {
  id              String      @id
  // Display name (free text, not unique). Better Auth calls it "name".
  name            String
  email           String      @unique
  emailVerified   Boolean     @default(false)
  image           String?
  // Lowercased by the username plugin, so uniqueness is case-insensitive.
  username        String      @unique
  // The username as the user typed it (set automatically by the plugin).
  displayUsername String
  role            Role        @default(user)
  // Admin plugin (milestone 2): "banned" = disabled by an admin. Sessions are deleted and
  // login is blocked. banReason/banExpires are required by the plugin but not used yet.
  banned          Boolean     @default(false)
  banReason       String?
  banExpires      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  sessions        Session[]
  accounts        Account[]
  alertRules      AlertRule[]
  channels        Channel[]

  @@map("user")
}

// One row per logged-in browser. The browser's cookie holds the token.
model Session {
  id             String   @id
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  // Admin plugin: set when an admin logs in as another user. Required by the plugin, not used.
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

// How a user logs in. For email + password: providerId = "credential" and the
// password hash is stored here. Social logins (later) add more rows per user.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  password              String?
  // Only used by social logins (OAuth).
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

// Short-lived tokens, e.g. for email verification and password reset (milestone 9).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Alert rules (milestone 3)
// ---------------------------------------------------------------------------

// How a rule finds articles. Only the matching field is filled:
// keywords → keywords is filled, category is null
// category → category is filled, keywords is []
enum AlertRuleType {
  keywords
  category
}

model AlertRule {
  id        String             @id @default(uuid(7))
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      AlertRuleType
  // 1–10 keywords as the user typed them (trimmed). ALL of them must appear in the article
  // (AND). Matching ignores case, so no lowercase copy is stored.
  keywords  String[]           @default([])
  // One of APP_CATEGORIES (packages/shared). Plain text, checked by the shared Zod schema,
  // so changing the category list needs no migration.
  category  String?
  // Switched-off rules are kept but never matched.
  enabled   Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  // Where matches are sent. At least one (checked by the shared Zod schema and the service).
  channels  AlertRuleChannel[]

  @@index([userId])
  @@map("alert_rule")
}

// ---------------------------------------------------------------------------
// Channels (milestone 4)
// ---------------------------------------------------------------------------

// Adding a type (slack in milestone 7) is a one-line migration.
enum ChannelType {
  email
}

// Where a user's alerts are sent. Every user has exactly one email channel (their account
// email), created after sign-up. "Only one email channel" is checked in the service.
model Channel {
  id             String             @id @default(uuid(7))
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           ChannelType
  // Settings that depend on the type, checked by the type's Zod schema. Email: {} (the address
  // is read from user.email when sending, so it is never out of date). Slack later: { webhookUrl }.
  config         Json               @default("{}")
  // For the "1 test message per minute" limit. Stored here, so it survives a restart.
  lastTestSentAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  alertRules     AlertRuleChannel[]

  @@index([userId])
  @@map("channel")
}

// Join table: which rule sends to which channel (many-to-many). One row per pair, so the same
// pair can't be saved twice. Deleting a rule, a channel or a user removes its rows.
model AlertRuleChannel {
  alertRuleId String
  alertRule   AlertRule @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  channelId   String
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  // The primary key starts with alertRuleId, so it also serves "channels of a rule".
  // The extra index serves "rules of a channel".
  @@id([alertRuleId, channelId])
  @@index([channelId])
  @@map("alert_rule_channel")
}
