// Database schema.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (milestone 1)
// The User, Session, Account and Verification models are the tables Better Auth
// needs (https://better-auth.com/docs/concepts/database). Field names must match
// what Better Auth expects. Our own fields: role, plus username/displayUsername
// from Better Auth's username plugin.
// ---------------------------------------------------------------------------

enum Role {
  user
  admin
}

model User {
  id              String    @id
  // Display name (free text, not unique). Better Auth calls it "name".
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  // Lowercased by the username plugin, so uniqueness is case-insensitive.
  username        String    @unique
  // The username as the user typed it (set automatically by the plugin).
  displayUsername String
  role            Role      @default(user)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]
  accounts        Account[]

  @@map("user")
}

// One row per logged-in browser. The browser's cookie holds the token.
model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

// How a user logs in. For email + password: providerId = "credential" and the
// password hash is stored here. Social logins (later) add more rows per user.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  password              String?
  // Only used by social logins (OAuth).
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

// Short-lived tokens, e.g. for email verification and password reset (milestone 9).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
